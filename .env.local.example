# Copy to .env — never commit .env
# Nuxt always loads .env; .env.local can be used for local overrides on top.

# ── Required ──────────────────────────────────────────────────────────────────

# Fireworks.ai API key (server-only, never exposed to browser)
# Get yours at: https://fireworks.ai → Settings → API Keys
FIREWORKS_API_KEY=

# Set to "true" to use the server key above as fallback when users haven't
# entered their own. Leave unset or "false" to require users to supply a key
# via the ⚙ keys UI.
DEMO_KEYS_ENABLED=

# Exposes demo-mode flag to the browser (boolean only — key value never leaves the server).
NUXT_PUBLIC_DEMO_KEYS_ENABLED=

# ── Optional ──────────────────────────────────────────────────────────────────

# Upstash Redis for rate limiting in production
# Get from: https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
