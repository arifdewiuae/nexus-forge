# Copy to .env.local — never commit .env.local

# Fireworks.ai API key (server-only, never exposed to browser)
# Get from: https://fireworks.ai → Settings → API Keys
FIREWORKS_API_KEY=

# y-websocket server URL (set after deploying ws-server to Fly.io in Phase 5)
# Local dev: ws://localhost:1234
NUXT_PUBLIC_WS_SERVER_URL=ws://localhost:1234

# Optional — Upstash Redis for rate limiting in Vercel production
# Get from: https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
